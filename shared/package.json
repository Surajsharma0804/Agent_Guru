{
  "name": "@guru/shared",
  "version": "1.0.0",
  "description": "Shared utilities and types for the Guru Personal Assistant system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "dev": "tsc --build --watch",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:properties": "jest --testNamePattern=\"Property\" --passWithNoTests",
    "test:unit": "jest --testNamePattern=\"Unit\" --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "fast-check": "^3.15.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ]
}