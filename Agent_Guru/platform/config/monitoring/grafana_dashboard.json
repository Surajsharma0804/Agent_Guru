{
  "title": "Agent Guru Platform Integration",
  "uid": "agent-guru-platform",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage %",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agent_guru_cpu_percent",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agent_guru_memory_bytes / 1e9",
          "legendFormat": "Memory GB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "GB",
          "min": 0,
          "max": 2,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1.5 },
              { "color": "red", "value": 1.8 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Operations/sec",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(agent_guru_operations_total[1m])",
          "legendFormat": "ops/sec"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(agent_guru_operation_errors_total[5m])",
          "legendFormat": "errors/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "agent_guru_cache_hit_rate * 100",
          "legendFormat": "Hit Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Throttle Events",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 4, "w": 12, "h": 4 },
      "targets": [
        {
          "expr": "rate(agent_guru_throttle_events_total[1m])",
          "legendFormat": "throttle events/sec"
        }
      ]
    },
    {
      "id": 7,
      "title": "Security Violations",
      "type": "stat",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "increase(agent_guru_security_violations_total[1h])",
          "legendFormat": "violations/hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "CPU & Memory Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "agent_guru_cpu_percent",
          "legendFormat": "CPU %"
        },
        {
          "expr": "agent_guru_memory_percent",
          "legendFormat": "Memory %"
        }
      ]
    }
  ]
}
