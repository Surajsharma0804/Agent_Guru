{
  "description": "Ingest pipeline for Agent Guru Reasoning Engine logs",
  "processors": [
    {
      "set": {
        "field": "event.ingested",
        "value": "{{_ingest.timestamp}}"
      }
    },
    {
      "grok": {
        "field": "message",
        "patterns": [
          "%{TIMESTAMP_ISO8601:timestamp} %{LOGLEVEL:log_level} %{DATA:logger} %{GREEDYDATA:message}"
        ],
        "ignore_failure": true
      }
    },
    {
      "date": {
        "field": "timestamp",
        "target_field": "@timestamp",
        "formats": [
          "ISO8601",
          "yyyy-MM-dd'T'HH:mm:ss.SSSZ",
          "yyyy-MM-dd HH:mm:ss,SSS"
        ],
        "ignore_failure": true
      }
    },
    {
      "remove": {
        "field": "timestamp",
        "ignore_failure": true
      }
    },
    {
      "script": {
        "lang": "painless",
        "source": "if (ctx.log_level != null) { ctx.log_level = ctx.log_level.toUpperCase(); }"
      }
    },
    {
      "set": {
        "field": "log.level",
        "value": "{{log_level}}",
        "if": "ctx.log_level != null"
      }
    },
    {
      "set": {
        "field": "event.severity",
        "value": 0,
        "if": "ctx.log_level == 'DEBUG'"
      }
    },
    {
      "set": {
        "field": "event.severity",
        "value": 1,
        "if": "ctx.log_level == 'INFO'"
      }
    },
    {
      "set": {
        "field": "event.severity",
        "value": 2,
        "if": "ctx.log_level == 'WARNING' || ctx.log_level == 'WARN'"
      }
    },
    {
      "set": {
        "field": "event.severity",
        "value": 3,
        "if": "ctx.log_level == 'ERROR'"
      }
    },
    {
      "set": {
        "field": "event.severity",
        "value": 4,
        "if": "ctx.log_level == 'CRITICAL' || ctx.log_level == 'FATAL'"
      }
    },
    {
      "geoip": {
        "field": "client.ip",
        "target_field": "client.geo",
        "ignore_failure": true
      }
    },
    {
      "user_agent": {
        "field": "user_agent.original",
        "ignore_failure": true
      }
    },
    {
      "fingerprint": {
        "fields": ["message", "log_level", "logger"],
        "target_field": "event.hash",
        "method": "SHA-256"
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "error.message",
        "value": "{{ _ingest.on_failure_message }}"
      }
    }
  ]
}
