# Production Environment Configuration Example
# Copy this file to terraform.tfvars and fill in the values

project_name = "agent-guru"
environment  = "production"
region       = "us-east-1"

availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# Kubernetes Configuration (Production-grade)
kubernetes_version  = "1.28"
node_instance_type  = "t3.xlarge"
node_count          = 3
min_nodes           = 2
max_nodes           = 10

# Database Configuration (Production-grade with Multi-AZ)
db_instance_class    = "db.r6g.xlarge"
db_allocated_storage = 100
db_engine_version    = "15.4"

# Redis Configuration (Production-grade with Multi-AZ)
redis_node_type              = "cache.r6g.xlarge"
redis_engine_version         = "7.0"
redis_parameter_group_family = "redis7"

# Monitoring Configuration
grafana_admin_password = "CHANGE_ME_STRONG_PASSWORD"
alert_webhook_url      = "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
alert_emails           = ["ops@example.com", "oncall@example.com"]

# Tags
tags = {
  Project     = "Agent Guru"
  Component   = "Core Reasoning Engine"
  ManagedBy   = "Terraform"
  Environment = "Production"
  CostCenter  = "Engineering"
  Compliance  = "Required"
}
