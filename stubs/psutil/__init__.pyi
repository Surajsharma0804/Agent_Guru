"""Type stubs for psutil (process and system utilities)."""
from typing import Any, Iterator

class Process:
    pid: int
    info: dict[str, Any]
    def __init__(self, pid: int | None = None) -> None: ...
    def name(self) -> str: ...
    def exe(self) -> str: ...
    def cmdline(self) -> list[str]: ...
    def status(self) -> str: ...
    def cpu_percent(self, interval: float | None = None) -> float: ...
    def memory_info(self) -> Any: ...
    def memory_percent(self) -> float: ...
    def terminate(self) -> None: ...
    def kill(self) -> None: ...
    def wait(self, timeout: float | None = None) -> int: ...
    def is_running(self) -> bool: ...
    def as_dict(self, attrs: list[str] | None = None) -> dict[str, Any]: ...

class NoSuchProcess(Exception):
    pid: int
    name: str | None
    msg: str | None

class AccessDenied(Exception):
    pid: int | None
    name: str | None

class ZombieProcess(Exception):
    pid: int
    name: str | None

def process_iter(attrs: list[str] | None = None, ad_value: Any = None) -> Iterator[Process]: ...
def cpu_count(logical: bool = True) -> int | None: ...
def cpu_percent(interval: float | None = None, percpu: bool = False) -> float | list[float]: ...
def virtual_memory() -> Any: ...
def swap_memory() -> Any: ...
def disk_usage(path: str) -> Any: ...
def disk_partitions(all: bool = False) -> list[Any]: ...
def net_io_counters(pernic: bool = False) -> Any: ...
def boot_time() -> float: ...
def pids() -> list[int]: ...
def pid_exists(pid: int) -> bool: ...
def sensors_battery() -> Any: ...
