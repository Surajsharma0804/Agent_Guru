# Line ending policy
# Normalize text files to LF in the repository. Without this, correct line
# endings depend on every contributor configuring core.autocrlf themselves,
# which the repo cannot rely on.
* text=auto

# Shell scripts run under bash on Linux and macOS, often copied there from a
# Windows checkout (the wake-word runner's data folder is built from one).
# text=auto alone let core.autocrlf=true write them with CRLF: in a fresh
# Windows clone all 76 lines of the three runner scripts ended in CRLF, and
# Linux bash refused submit_chain.sh ("syntax error near unexpected token
# $'do\r'", "set: pipefail: invalid option name"). eol=lf keeps every
# checkout of them LF, on every platform and whatever the local setting.
*.sh text eol=lf

# Language detection overrides
*.rs linguist-language=Rust
*.py linguist-language=Python
*.toml linguist-language=TOML
*.md linguist-language=Markdown

# Exclude vendor and generated files from language statistics
vendor/* linguist-vendored
target/* linguist-generated
.hypothesis/* linguist-generated
.pytest_cache/* linguist-generated
proptest-regressions/* linguist-generated
**/__pycache__/* linguist-generated
*.rlib linguist-generated

# Documentation
docs/* linguist-documentation

# Configuration files
*.toml linguist-detectable=true
Cargo.lock linguist-generated

# Ensure Rust is properly detected
*.rs linguist-detectable=true
*.py linguist-detectable=true

# Mark test files appropriately
**/tests/* linguist-detectable=true
**/*test*.rs linguist-detectable=true
**/*test*.py linguist-detectable=true
**/property_tests.* linguist-detectable=true