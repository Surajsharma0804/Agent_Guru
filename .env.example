# Agent Guru — Required Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Conversation memory key identifier (used for keychain lookup)
CONVERSATION_KEY_ID=<your-conversation-key-id-here>

# PostgreSQL password — required when running docker-compose
# Set a strong, unique password here; never use a default or commit the real value.
POSTGRES_PASSWORD=your-postgres-password-here

# ── LLM Model (Ollama) ────────────────────────────────────────────────────────
# Best model for 4GB VRAM (RTX 2050/3050/4050): gemma3:4b
# Pull it once: ollama pull gemma3:4b
# Other good options for 4GB VRAM:
#   qwen2.5:3b   — fastest, great multilingual
#   phi4-mini    — strong reasoning, 3.8B
#   llama3.2:3b  — Meta's latest small model
OLLAMA_MODEL=gemma3:4b

# ── Browser Channel ───────────────────────────────────────────────────────────
# Which browser to use for YouTube automation.
# "chrome"  — real Google Chrome (recommended, has all media codecs)
# "msedge"  — real Microsoft Edge
# Leave blank to auto-detect (tries chrome → msedge → bundled Chromium)
AGENT_GURU_BROWSER_CHANNEL=chrome

# ── YouTube Data API (optional but recommended) ───────────────────────────────
# Get a free key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Without this, Agent Guru uses Playwright scraping (slower, may break on YouTube changes)
# YOUTUBE_API_KEY=your-youtube-api-key-here

# ── Ollama Production Optimization (Phase 2) ─────────────────────────────────
# KEEP_ALIVE=-1 pins model in VRAM permanently — eliminates cold-start latency
# FLASH_ATTENTION=1 enables fused attention kernels on CUDA GPUs
# NUM_PARALLEL=1 controls concurrent request handling (increase based on VRAM)
# HOST=127.0.0.1:11434 binds Ollama to localhost only (security)
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_HOST=127.0.0.1:11434

# ── Redis (required for caching/sessions) ─────────────────────────────────────
# Set a strong password. Used by the resilience cache and session manager.
# REDIS_PASSWORD=your-redis-password-here

# ── Security ──────────────────────────────────────────────────────────────────
# SECRET_KEY is used for signing tokens and encrypting session data.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=your-secret-key-here

# ── Reliability (Phase 1) ─────────────────────────────────────────────────────
# Maximum time (seconds) to wait for subsystem startup before continuing
AGENT_GURU_STARTUP_TIMEOUT=30
# Maximum automatic restarts before giving up
AGENT_GURU_MAX_RESTARTS=3
