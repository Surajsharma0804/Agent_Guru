<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Base.Theme.GuruPhoneAgent" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/guru_primary</item>
        <item name="colorOnPrimary">@color/guru_on_primary</item>
        <item name="colorPrimaryContainer">@color/guru_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/guru_on_primary_container</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/guru_secondary</item>
        <item name="colorOnSecondary">@color/guru_on_secondary</item>
        <item name="colorSecondaryContainer">@color/guru_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/guru_on_secondary_container</item>
        
        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/guru_tertiary</item>
        <item name="colorOnTertiary">@color/guru_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/guru_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/guru_on_tertiary_container</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/guru_error</item>
        <item name="colorOnError">@color/guru_on_error</item>
        <item name="colorErrorContainer">@color/guru_error_container</item>
        <item name="colorOnErrorContainer">@color/guru_on_error_container</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/guru_surface</item>
        <item name="colorOnSurface">@color/guru_on_surface</item>
        <item name="colorSurfaceVariant">@color/guru_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/guru_on_surface_variant</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/guru_background</item>
        <item name="colorOnBackground">@color/guru_on_background</item>
        
        <!-- Outline colors -->
        <item name="colorOutline">@color/guru_outline</item>
        <item name="colorOutlineVariant">@color/guru_outline_variant</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/guru_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/guru_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Security and accessibility -->
        <item name="android:windowAllowsScreenshots">false</item>
        <item name="android:windowSecure">true</item>
    </style>
    
    <!-- Application theme -->
    <style name="Theme.GuruPhoneAgent" parent="Base.Theme.GuruPhoneAgent" />
    
    <!-- Splash screen theme -->
    <style name="Theme.GuruPhoneAgent.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/guru_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.GuruPhoneAgent</item>
    </style>
</resources>