{
  "dashboard": {
    "title": "Capacity Planning - Resource Utilization",
    "tags": ["reasoning-engine", "capacity", "production", "resources"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "100 * rate(process_cpu_seconds_total{job=\"reasoning-engine\"}[5m])",
            "legendFormat": "CPU Usage % - {{instance}}",
            "refId": "A"
          },
          {
            "expr": "100 * avg(rate(process_cpu_seconds_total{job=\"reasoning-engine\"}[5m]))",
            "legendFormat": "Average CPU Usage %",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "CPU Usage", "min": 0, "max": 100},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true,
          "max": true
        },
        "thresholds": [
          {
            "value": 75,
            "colorMode": "custom",
            "op": "gt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(237, 129, 40, 0.8)"
          },
          {
            "value": 90,
            "colorMode": "custom",
            "op": "gt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(244, 67, 54, 0.8)"
          }
        ]
      },
      {
        "id": 2,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"reasoning-engine\"} / 1024 / 1024",
            "legendFormat": "Memory Usage MB - {{instance}}",
            "refId": "A"
          },
          {
            "expr": "avg(process_resident_memory_bytes{job=\"reasoning-engine\"}) / 1024 / 1024",
            "legendFormat": "Average Memory Usage MB",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "mbytes", "label": "Memory Usage"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true,
          "max": true
        },
        "thresholds": [
          {
            "value": 1500,
            "colorMode": "custom",
            "op": "gt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(237, 129, 40, 0.8)"
          },
          {
            "value": 1800,
            "colorMode": "custom",
            "op": "gt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(244, 67, 54, 0.8)"
          }
        ]
      },
      {
        "id": 3,
        "title": "Disk Usage",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"reasoning-engine\",mountpoint=\"/\"} / node_filesystem_size_bytes))",
            "legendFormat": "Disk Usage % - {{instance}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Disk Usage", "min": 0, "max": 100},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true,
          "max": true
        },
        "thresholds": [
          {
            "value": 80,
            "colorMode": "custom",
            "op": "gt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(237, 129, 40, 0.8)"
          },
          {
            "value": 90,
            "colorMode": "custom",
            "op": "gt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(244, 67, 54, 0.8)"
          }
        ]
      },
      {
        "id": 4,
        "title": "Network I/O",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total{job=\"reasoning-engine\"}[5m]) / 1024 / 1024",
            "legendFormat": "Network In MB/s - {{instance}}",
            "refId": "A"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total{job=\"reasoning-engine\"}[5m]) / 1024 / 1024",
            "legendFormat": "Network Out MB/s - {{instance}}",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "MBs", "label": "Network I/O"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true,
          "max": true
        }
      },
      {
        "id": 5,
        "title": "Request Rate Trend",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(reasoning_engine_requests_total[5m]))",
            "legendFormat": "Current Request Rate",
            "refId": "A"
          },
          {
            "expr": "avg_over_time(sum(rate(reasoning_engine_requests_total[5m]))[1h:])",
            "legendFormat": "1h Average",
            "refId": "B"
          },
          {
            "expr": "avg_over_time(sum(rate(reasoning_engine_requests_total[5m]))[6h:])",
            "legendFormat": "6h Average",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/s"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true
        }
      },
      {
        "id": 6,
        "title": "Capacity Headroom",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "100 - (100 * rate(process_cpu_seconds_total{job=\"reasoning-engine\"}[5m]))",
            "legendFormat": "CPU Headroom %",
            "refId": "A"
          },
          {
            "expr": "100 * (node_memory_MemAvailable_bytes{job=\"reasoning-engine\"} / node_memory_MemTotal_bytes)",
            "legendFormat": "Memory Headroom %",
            "refId": "B"
          },
          {
            "expr": "100 * (node_filesystem_avail_bytes{job=\"reasoning-engine\",mountpoint=\"/\"} / node_filesystem_size_bytes)",
            "legendFormat": "Disk Headroom %",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Available Capacity", "min": 0, "max": 100},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true,
          "min": true
        },
        "thresholds": [
          {
            "value": 10,
            "colorMode": "custom",
            "op": "lt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(244, 67, 54, 0.8)"
          },
          {
            "value": 25,
            "colorMode": "custom",
            "op": "lt",
            "fill": false,
            "line": true,
            "lineColor": "rgba(237, 129, 40, 0.8)"
          }
        ]
      },
      {
        "id": 7,
        "title": "Instance Count & Load Distribution",
        "type": "graph",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "count(up{job=\"reasoning-engine\"} == 1)",
            "legendFormat": "Active Instances",
            "refId": "A"
          },
          {
            "expr": "sum(rate(reasoning_engine_requests_total[5m])) / count(up{job=\"reasoning-engine\"} == 1)",
            "legendFormat": "Avg Requests/s per Instance",
            "refId": "B",
            "yAxisIndex": 1
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Instance Count"},
          {"format": "reqps", "label": "Requests/s"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true
        }
      },
      {
        "id": 8,
        "title": "Projected Capacity (Next 7 Days)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "predict_linear(sum(rate(reasoning_engine_requests_total[1h]))[6h:], 7*24*3600)",
            "legendFormat": "Projected Request Rate (7d)",
            "refId": "A"
          },
          {
            "expr": "sum(rate(reasoning_engine_requests_total[5m]))",
            "legendFormat": "Current Request Rate",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/s"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true
        }
      },
      {
        "id": 9,
        "title": "Resource Utilization Summary",
        "type": "table",
        "gridPos": {"x": 0, "y": 32, "w": 24, "h": 6},
        "targets": [
          {
            "expr": "100 * rate(process_cpu_seconds_total{job=\"reasoning-engine\"}[5m])",
            "format": "table",
            "instant": true,
            "refId": "A"
          },
          {
            "expr": "process_resident_memory_bytes{job=\"reasoning-engine\"} / 1024 / 1024",
            "format": "table",
            "instant": true,
            "refId": "B"
          },
          {
            "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"reasoning-engine\",mountpoint=\"/\"} / node_filesystem_size_bytes))",
            "format": "table",
            "instant": true,
            "refId": "C"
          }
        ],
        "styles": [
          {
            "pattern": "instance",
            "type": "string",
            "alias": "Instance"
          },
          {
            "pattern": "Value #A",
            "type": "number",
            "alias": "CPU %",
            "unit": "percent",
            "decimals": 1,
            "colorMode": "cell",
            "colors": ["rgba(50, 172, 45, 0.97)", "rgba(237, 129, 40, 0.89)", "rgba(245, 54, 54, 0.9)"],
            "thresholds": ["75", "90"]
          },
          {
            "pattern": "Value #B",
            "type": "number",
            "alias": "Memory MB",
            "unit": "mbytes",
            "decimals": 0,
            "colorMode": "cell",
            "colors": ["rgba(50, 172, 45, 0.97)", "rgba(237, 129, 40, 0.89)", "rgba(245, 54, 54, 0.9)"],
            "thresholds": ["1500", "1800"]
          },
          {
            "pattern": "Value #C",
            "type": "number",
            "alias": "Disk %",
            "unit": "percent",
            "decimals": 1,
            "colorMode": "cell",
            "colors": ["rgba(50, 172, 45, 0.97)", "rgba(237, 129, 40, 0.89)", "rgba(245, 54, 54, 0.9)"],
            "thresholds": ["80", "90"]
          }
        ]
      }
    ]
  }
}
