      "timeout_seconds": 30,
      "max_retries": 2
    },
    
    "conversation": {
      "provider": "ollama",
      "model": "qwen2.5:7b-instruct",
      "enabled": true,
      "fallback_provider": null,
      "fallback_model": null,
      "timeout_seconds": 120,
      "max_retries": 2
    },
    
    "deep_reasoning": {
      "provider": "disabled",
      "model": "",
      "enabled": false,
      "fallback_provider": null,
      "fallback_model": null,
      "timeout_seconds": 60,
