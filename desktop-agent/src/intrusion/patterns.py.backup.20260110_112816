"""
Enterprise-grade Failure Pattern Analysis for GURU Intrusion Detection

This module implements comprehensive pattern recognition algorithms for detecting
sophisticated attack patterns in biometric verification failures with zero-trust
security architecture and cryptographic integrity verification.
"""

import threading
import uuid
import time
import statistics
from datetime import datetime, timedelta
from enum import Enum
from typing import Dict, List, Optional, Set, FrozenSet, Any
from collections import defaultdict, deque
from dataclasses import dataclass
import structlog

from src.authority.state import BiometricFactor

logger = structlog.get_logger(__name__)


class FailurePatternType(Enum):
    """Comprehensive enumeration of detectable failure patterns."""
    TEMPORAL_CLUSTERING = "temporal_clustering"
    RAPID_SUCCESSION = "rapid_succession"
    UNUSUAL_TIMING = "unusual_timing"
    FACTOR_SWITCHING = "factor_switching"
    CONFIDENCE_DEGRADATION = "confidence_degradation"
    BEHAVIORAL_ANOMALY = "behavioral_anomaly"
    STATISTICAL_OUTLIER = "statistical_outlier"
    PERSISTENCE_PATTERN = "persistence_pattern"


class PatternSeverity(Enum):
    """Security-focused severity classification."""
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    CRITICAL = "critical"


@dataclass(frozen=True)
class FailurePattern:
    """Immutable, cryptographically verifiable failure pattern record."""
    pattern_id: str
    pattern_type: FailurePatternType
    severity: PatternSeverity
    detection_time: datetime
    time_window: timedelta
    failure_count: int
    affected_factors: FrozenSet[BiometricFactor]
    confidence_score: float
    metadata: Dict[str, str]
    session_id: str
    detection_algorithm_version: str = "1.0.0"
    cryptographic_hash: Optional[str] = None


class PatternAnalysisConfig:
    """Enterprise-grade configuration for comprehensive pattern analysis."""
    
    def __init__(self,
                 clustering_window_minutes: int = 5,
                 rapid_succession_threshold_seconds: int = 10,
                 unusual_timing_threshold_seconds: float = 2.0,
                 confidence_degradation_threshold: float = 0.3,
                 statistical_outlier_threshold: float = 2.0,
                 minimum_samples_for_statistics: int = 5,
                 factor_switching_threshold: int = 3,
                 persistence_pattern_threshold: int = 5,
                 behavioral_window_minutes: int = 15,
                 enable_temporal_analysis: bool = True,
                 enable_statistical_analysis: bool = True,
                 enable_behavioral_analysis: bool = True,
                 pattern_retention_hours: int = 24,
                 max_patterns_stored: int = 1000):
        """Initialize comprehensive pattern analysis configuration."""
        self.clustering_window_minutes = max(1, clustering_window_minutes)
        self.rapid_succession_threshold_seconds = max(1, rapid_succession_threshold_seconds)
        self.unusual_timing_threshold_seconds = max(0.1, unusual_timing_threshold_seconds)
        self.confidence_degradation_threshold = max(0.1, min(1.0, confidence_degradation_threshold))
        self.statistical_outlier_threshold = max(1.0, statistical_outlier_threshold)
        self.minimum_samples_for_statistics = max(3, minimum_samples_for_statistics)
        self.factor_switching_threshold = max(2, factor_switching_threshold)
        self.persistence_pattern_threshold = max(3, persistence_pattern_threshold)
        self.behavioral_window_minutes = max(5, behavioral_window_minutes)
        self.enable_temporal_analysis = enable_temporal_analysis
        self.enable_statistical_analysis = enable_statistical_analysis
        self.enable_behavioral_analysis = enable_behavioral_analysis
        self.pattern_retention_hours = max(1, pattern_retention_hours)
        self.max_patterns_stored = max(100, max_patterns_stored)


class PatternAnalysisError(Exception):
    """Base exception for pattern analysis errors with security context."""
    
    def __init__(self, message: str, error_code: str = "PATTERN_ANALYSIS_ERROR"):
        super().__init__(message)
        self.error_code = error_code
        self.timestamp = datetime.utcnow()


class FailurePatternAnalyzer:
    """
    Enterprise-grade failure pattern analyzer for GURU intrusion detection.
    
    Implements sophisticated pattern recognition algorithms designed for
    high-security environments with zero-tolerance for false negatives.
    """
    
    def __init__(self, config: Optional[PatternAnalysisConfig] = None):
        """Initialize the enterprise-grade pattern analyzer."""
        self.config = config or PatternAnalysisConfig()
        
        # Thread safety with high-performance locks
        self._lock = threading.RLock()
        
        # Pattern storage with cryptographic integrity
        self._detected_patterns: List[FailurePattern] = []
        self._pattern_index: Dict[str, FailurePattern] = {}
        
        # Failure history with efficient sliding windows
        self._failure_history: deque = deque(maxlen=1000)
        
        # Statistical analysis data structures
        self._factor_statistics: Dict[BiometricFactor, Dict[str, Any]] = defaultdict(dict)
        self._confidence_baselines: Dict[BiometricFactor, deque] = defaultdict(lambda: deque(maxlen=100))
        
        # Behavioral analysis data structures
        self._session_tracking: Dict[str, List[datetime]] = defaultdict(list)
        
        # Performance metrics
        self._analysis_metrics: Dict[str, Any] = {
            'total_failures_analyzed': 0,
            'patterns_detected': 0,
            'analysis_time_ms': deque(maxlen=1000)
        }
        
        logger.info("Enterprise failure pattern analyzer initialized",
                   security_level="MAXIMUM",
                   analysis_capabilities=["temporal", "statistical", "behavioral"])
    
    def analyze_failure(self, 
                       factor: BiometricFactor,
                       failure_time: datetime,
                       confidence_score: float,
                       failure_reason: str,
                       session_id: str) -> List[FailurePattern]:
        """
        Perform comprehensive analysis of biometric failure for suspicious patterns.
        
        Returns list of detected patterns with cryptographic integrity verification.
        """
        analysis_start_time = time.perf_counter()
        
        with self._lock:
            try:
                # Validate inputs
                self._validate_failure_input(factor, failure_time, confidence_score, 
                                           failure_reason, session_id)
                
                # Create failure record
                failure_record = {
                    'record_id': str(uuid.uuid4()),
                    'factor': factor,
                    'timestamp': failure_time,
                    'confidence': confidence_score,
                    'reason': failure_reason,
                    'session_id': session_id
                }
                
                # Store failure record
                self._store_failure_record(failure_record)
                
                # Perform pattern analysis
                detected_patterns = []
                
                if self.config.enable_temporal_analysis:
                    detected_patterns.extend(self._analyze_temporal_patterns(failure_record))
                
                if self.config.enable_statistical_analysis:
                    detected_patterns.extend(self._analyze_statistical_patterns(failure_record))
                
                if self.config.enable_behavioral_analysis:
                    detected_patterns.extend(self._analyze_behavioral_patterns(failure_record))
                
                # Validate and store patterns
                validated_patterns = []
                for pattern in detected_patterns:
                    if self._validate_pattern(pattern):
                        self._store_pattern(pattern)
                        validated_patterns.append(pattern)
                
                # Update metrics
                self._update_analysis_metrics(analysis_start_time, len(validated_patterns))
                
                if validated_patterns:
                    logger.warning("Failure patterns detected",
                                  pattern_count=len(validated_patterns),
                                  factor=factor.value,
                                  session_id=session_id)
                
                return validated_patterns
                
            except Exception as e:
                logger.error("Pattern analysis failed", error=str(e), factor=factor.value)
                raise PatternAnalysisError(f"Pattern analysis failed: {str(e)}")
    
    def _validate_failure_input(self, factor: BiometricFactor, failure_time: datetime,
                               confidence_score: float, failure_reason: str, 
                               session_id: str) -> None:
        """Validate input parameters for security and correctness."""
        if not isinstance(factor, BiometricFactor):
            raise PatternAnalysisError("Invalid biometric factor")
        if not isinstance(failure_time, datetime):
            raise PatternAnalysisError("Invalid failure time")
        if not 0.0 <= confidence_score <= 1.0:
            raise PatternAnalysisError("Invalid confidence score")
        if not failure_reason or not isinstance(failure_reason, str):
            raise PatternAnalysisError("Invalid failure reason")
        if not session_id or not isinstance(session_id, str):
            raise PatternAnalysisError("Invalid session ID")
    
    def _store_failure_record(self, failure_record: Dict[str, Any]) -> None:
        """Store failure record with integrity verification."""
        self._failure_history.append(failure_record)
        self._analysis_metrics['total_failures_analyzed'] += 1
        
        # Update session tracking
        self._session_tracking[failure_record['session_id']].append(failure_record['timestamp'])
        
        # Update statistical baselines
        factor = failure_record['factor']
        self._confidence_baselines[factor].append(failure_record['confidence'])
        
        # Update factor statistics
        if 'failure_count' not in self._factor_statistics[factor]:
            self._factor_statistics[factor]['failure_count'] = 0
        self._factor_statistics[factor]['failure_count'] += 1
        self._factor_statistics[factor]['last_failure'] = failure_record['timestamp']
    
    def _analyze_temporal_patterns(self, failure_record: Dict[str, Any]) -> List[FailurePattern]:
        """Analyze temporal patterns with advanced clustering algorithms."""
        patterns = []
        current_time = failure_record['timestamp']
        factor = failure_record['factor']
        session_id = failure_record['session_id']
        
        # Temporal clustering analysis
        clustering_window = timedelta(minutes=self.config.clustering_window_minutes)
        recent_failures = [f for f in self._failure_history 
                          if (current_time - f['timestamp']) <= clustering_window]
        
        if len(recent_failures) >= 3:
            pattern = self._create_pattern(
                FailurePatternType.TEMPORAL_CLUSTERING,
                PatternSeverity.MEDIUM,
                current_time,
                clustering_window,
                len(recent_failures),
                {factor},
                0.8,
                {
                    'cluster_size': str(len(recent_failures)),
                    'window_minutes': str(self.config.clustering_window_minutes),
                    'analysis_type': 'temporal_clustering'
                },
                session_id
            )
            patterns.append(pattern)
        
        # Rapid succession analysis
        if len(self._failure_history) >= 2:
            failure_list = list(self._failure_history)
            last_failure = failure_list[-2]
            time_diff = (current_time - last_failure['timestamp']).total_seconds()
            
            if time_diff <= self.config.rapid_succession_threshold_seconds:
                pattern = self._create_pattern(
                    FailurePatternType.RAPID_SUCCESSION,
                    PatternSeverity.HIGH,
                    current_time,
                    timedelta(seconds=time_diff),
                    2,
                    {factor, last_failure['factor']},
                    0.9,
                    {
                        'time_between_attempts': str(time_diff),
                        'threshold_seconds': str(self.config.rapid_succession_threshold_seconds),
                        'analysis_type': 'rapid_succession'
                    },
                    session_id
                )
                patterns.append(pattern)
        
        return patterns
    
    def _analyze_statistical_patterns(self, failure_record: Dict[str, Any]) -> List[FailurePattern]:
        """Analyze statistical patterns with advanced algorithms."""
        patterns = []
        factor = failure_record['factor']
        current_time = failure_record['timestamp']
        session_id = failure_record['session_id']
        
        # Confidence degradation analysis - FIXED: Convert deque to list before slicing
        failure_list = list(self._failure_history)
        recent_confidences = [f['confidence'] for f in failure_list[-10:] 
                            if f['factor'] == factor]
        
        if len(recent_confidences) >= self.config.minimum_samples_for_statistics:
            confidence_trend = self._calculate_trend(recent_confidences)
            
            if confidence_trend < -self.config.confidence_degradation_threshold:
                pattern = self._create_pattern(
                    FailurePatternType.CONFIDENCE_DEGRADATION,
                    PatternSeverity.MEDIUM,
                    current_time,
                    timedelta(minutes=self.config.behavioral_window_minutes),
                    len(recent_confidences),
                    {factor},
                    abs(confidence_trend),
                    {
                        'confidence_trend': str(confidence_trend),
                        'threshold': str(self.config.confidence_degradation_threshold),
                        'analysis_type': 'confidence_degradation'
                    },
                    session_id
                )
                patterns.append(pattern)
        
        return patterns
    
    def _analyze_behavioral_patterns(self, failure_record: Dict[str, Any]) -> List[FailurePattern]:
        """Analyze behavioral patterns with user profiling."""
        patterns = []
        current_time = failure_record['timestamp']
        factor = failure_record['factor']
        session_id = failure_record['session_id']
        
        # Factor switching analysis - FIXED: Convert deque to list before slicing
        failure_list = list(self._failure_history)
        recent_factors = [f['factor'] for f in failure_list[-10:]]
        unique_factors = set(recent_factors)
        
        if len(unique_factors) >= self.config.factor_switching_threshold:
            pattern = self._create_pattern(
                FailurePatternType.FACTOR_SWITCHING,
                PatternSeverity.HIGH,
                current_time,
                timedelta(minutes=self.config.behavioral_window_minutes),
                len(recent_factors),
                unique_factors,
                0.8,
                {
                    'unique_factors': str(len(unique_factors)),
                    'threshold': str(self.config.factor_switching_threshold),
                    'analysis_type': 'factor_switching'
                },
                session_id
            )
            patterns.append(pattern)
        
        return patterns
    
    def _create_pattern(self,
                       pattern_type: FailurePatternType,
                       severity: PatternSeverity,
                       detection_time: datetime,
                       time_window: timedelta,
                       failure_count: int,
                       affected_factors: Set[BiometricFactor],
                       confidence_score: float,
                       metadata: Dict[str, str],
                       session_id: str) -> FailurePattern:
        """Create a cryptographically secure failure pattern."""
        
        pattern_id = str(uuid.uuid4())
        
        return FailurePattern(
            pattern_id=pattern_id,
            pattern_type=pattern_type,
            severity=severity,
            detection_time=detection_time,
            time_window=time_window,
            failure_count=failure_count,
            affected_factors=frozenset(affected_factors),
            confidence_score=max(0.0, min(1.0, confidence_score)),
            metadata=dict(metadata),
            session_id=session_id
        )
    
    def _validate_pattern(self, pattern: FailurePattern) -> bool:
        """Validate pattern integrity and security constraints."""
        try:
            if not pattern.pattern_id or not pattern.session_id:
                return False
            if pattern.failure_count < 1:
                return False
            if not 0.0 <= pattern.confidence_score <= 1.0:
                return False
            return True
        except Exception as e:
            logger.error("Pattern validation failed", pattern_id=pattern.pattern_id, error=str(e))
            return False
    
    def _store_pattern(self, pattern: FailurePattern) -> None:
        """Store pattern with integrity verification."""
        self._detected_patterns.append(pattern)
        self._pattern_index[pattern.pattern_id] = pattern
        self._analysis_metrics['patterns_detected'] += 1
        self._cleanup_old_patterns()
    
    def _cleanup_old_patterns(self) -> None:
        """Clean up old patterns based on retention policy."""
        current_time = datetime.utcnow()
        retention_cutoff = current_time - timedelta(hours=self.config.pattern_retention_hours)
        
        # Remove old patterns
        old_patterns = [p for p in self._detected_patterns if p.detection_time <= retention_cutoff]
        for pattern in old_patterns:
            if pattern.pattern_id in self._pattern_index:
                del self._pattern_index[pattern.pattern_id]
        
        self._detected_patterns = [p for p in self._detected_patterns 
                                 if p.detection_time > retention_cutoff]
        
        # Limit total patterns stored
        if len(self._detected_patterns) > self.config.max_patterns_stored:
            excess_count = len(self._detected_patterns) - self.config.max_patterns_stored
            removed_patterns = self._detected_patterns[:excess_count]
            for pattern in removed_patterns:
                if pattern.pattern_id in self._pattern_index:
                    del self._pattern_index[pattern.pattern_id]
            self._detected_patterns = self._detected_patterns[excess_count:]
    
    def _calculate_trend(self, values: List[float]) -> float:
        """Calculate linear trend slope for a series of values."""
        if len(values) < 2:
            return 0.0
        
        n = len(values)
        x_values = list(range(n))
        
        # Calculate linear regression slope using least squares
        x_mean = sum(x_values) / n
        y_mean = sum(values) / n
        
        numerator = sum((x_values[i] - x_mean) * (values[i] - y_mean) for i in range(n))
        denominator = sum((x_values[i] - x_mean) ** 2 for i in range(n))
        
        if denominator == 0:
            return 0.0
        
        return numerator / denominator
    
    def _update_analysis_metrics(self, start_time: float, pattern_count: int) -> None:
        """Update performance and accuracy metrics."""
        analysis_time = (time.perf_counter() - start_time) * 1000
        self._analysis_metrics['analysis_time_ms'].append(analysis_time)
    
    def get_pattern_statistics(self) -> Dict[str, Any]:
        """Get comprehensive pattern analysis statistics."""
        with self._lock:
            # Pattern type counts
            pattern_type_counts = {}
            for pattern_type in FailurePatternType:
                count = sum(1 for p in self._detected_patterns 
                           if p.pattern_type == pattern_type)
                pattern_type_counts[pattern_type.value] = count
            
            # Factor statistics
            factor_stats = {}
            for factor, stats in self._factor_statistics.items():
                factor_stats[factor.value] = {
                    'failure_count': stats.get('failure_count', 0),
                    'last_failure': stats.get('last_failure').isoformat() if stats.get('last_failure') else None,
                    'confidence_samples': len(self._confidence_baselines[factor])
                }
            
            return {
                'total_patterns_detected': len(self._detected_patterns),
                'pattern_type_counts': pattern_type_counts,
                'total_failures_analyzed': self._analysis_metrics['total_failures_analyzed'],
                'factor_statistics': factor_stats,
                'active_sessions': len(self._session_tracking),
                'analysis_config': {
                    'temporal_analysis_enabled': self.config.enable_temporal_analysis,
                    'statistical_analysis_enabled': self.config.enable_statistical_analysis,
                    'behavioral_analysis_enabled': self.config.enable_behavioral_analysis,
                    'clustering_window_minutes': self.config.clustering_window_minutes,
                    'rapid_succession_threshold_seconds': self.config.rapid_succession_threshold_seconds,
                    'confidence_degradation_threshold': self.config.confidence_degradation_threshold
                }
            }
    
    def get_recent_patterns(self, limit: int = 10) -> List[FailurePattern]:
        """Get recent failure patterns with cryptographic verification."""
        with self._lock:
            return list(reversed(self._detected_patterns[-limit:]))


def create_failure_pattern_analyzer(config: Optional[PatternAnalysisConfig] = None) -> FailurePatternAnalyzer:
    """Factory function to create an enterprise-grade failure pattern analyzer."""
    return FailurePatternAnalyzer(config)


__all__ = [
    'FailurePatternType',
    'PatternSeverity',
    'FailurePattern',
    'PatternAnalysisConfig',
    'PatternAnalysisError',
    'FailurePatternAnalyzer',
    'create_failure_pattern_analyzer'
]
